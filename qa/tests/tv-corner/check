#!/usr/bin/env bash
# Corners must be CP437, not the GB2312 pair of corner+bar.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
python3 - "$ROOT" << 'PY'
import sys
from pathlib import Path

try:
    from PIL import Image
except ImportError:
    import subprocess
    subprocess.check_call([sys.executable, "-m", "pip", "install", "pillow", "-q"])
    from PIL import Image

root = Path(sys.argv[1])
img = Image.open(root / "qa/out/captures/tv-corner.png").convert("RGB")
hzk = (root / "fonts/HZK16").read_bytes()
CELL_W, CELL_H = 8, 18

def bits(row, col):
    x0, y0 = col * CELL_W, row * CELL_H
    rows = []
    for y in range(16):
        b = 0
        for x in range(8):
            r, g, bl = img.getpixel((x0 + x, y0 + y))
            if r > 200 and g > 200 and bl > 200:
                b |= 0x80 >> x
        rows.append(b)
    return rows

def glyph(lead, trail):
    index = (lead - 0xA1) * 94 + (trail - 0xA1)
    raw = hzk[index * 32:index * 32 + 32]
    out = []
    for i in range(16):
        out.append((raw[i * 2] << 8) | raw[i * 2 + 1])
    return out

def window16(row, col):
    x0, y0 = col * CELL_W, row * CELL_H
    rows = []
    for y in range(16):
        v = 0
        for x in range(16):
            r, g, bl = img.getpixel((x0 + x, y0 + y))
            if r > 200 and g > 200 and bl > 200:
                v |= 0x8000 >> x
        rows.append(v)
    return rows

def dist(a, b):
    n = 0
    for x, y in zip(a, b):
        n += (x ^ y).bit_count()
    return n

def dump(rows):
    return " ".join(f"{b:08b}" for b in rows)

bars = []
verts = []
pairs = [
    (0, 1, 0xC9, 0xCD, 1, "double"),
    (3, 1, 0xCD, 0xBB, 3, "double"),
    (0, 3, 0xC8, 0xCD, 1, "double"),
    (3, 3, 0xCD, 0xBC, 3, "double"),
    (0, 5, 0xDA, 0xC4, 1, "single"),
    (3, 5, 0xC4, 0xBF, 3, "single"),
    (0, 7, 0xC0, 0xC4, 1, "single"),
    (3, 7, 0xC4, 0xD9, 3, "single"),
    (0, 10, 0xC0, 0xC4, 1, "single"),
]
fail = 0
for col, row, lead, trail, bar_col, kind in pairs:
    d = dist(window16(row, col), glyph(lead, trail))
    print(f"pair {lead:02X}{trail:02X} @ {col},{row} dist {d}")
    if d < 24:
        print("  FAIL still the hanzi")
        fail += 1
    bars.append((bar_col, row, kind))

for col, row, kind in [(0, 2, "double"), (4, 2, "double"), (0, 6, "single"), (4, 6, "single"), (0, 9, "double")]:
    verts.append((col, row, kind))

# Learn nothing: require a real line, not a blank and not a 16-wide hanzi blob.
for col, row, kind in bars:
    rows = bits(row, col)
    full = sum(1 for b in rows if b == 0xFF)
    ink = sum(b.bit_count() for b in rows)
    print(f"bar {kind} @ {col},{row} full={full} ink={ink} {dump(rows)}")
    if kind == "double":
        ok = full == 2 and 8 <= ink <= 24
    else:
        ok = full == 1 and 4 <= ink <= 16
    if not ok:
        print("  FAIL bar shape")
        fail += 1

for col, row, kind in verts:
    rows = bits(row, col)
    ink = sum(b.bit_count() for b in rows)
    same = len(set(rows))
    print(f"vert {kind} @ {col},{row} ink={ink} uniq={same} {dump(rows)}")
    if ink < 16 or same > 3:
        print("  FAIL vertical shape")
        fail += 1

sys.exit(1 if fail else 0)
PY
