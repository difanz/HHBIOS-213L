# Google layout for C89/C++98 DOS sources as well as host probes.
# Assembly ABI names and Watcom UI hooks keep their existing spelling.
BasedOnStyle: Google
ColumnLimit: 80
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
InsertBraces: true
AttributeMacros:
  - CALL
  - FAR
  - far
